# Copy to .env (git-ignored). Never commit real values.

# --- ACXD (used only by acxd/*.mjs scripts, run in your own terminal) ---
ACXD_API_KEY=acxd_live_xxxxxxxx.xxxxxxxxxxxxxxxx
ACXD_WORKSPACE_ID=

# --- Live Sync keys (from the published ACXD application; served only via /api/livesync-token) ---
LIVESYNC_DEPLOYMENT_KEY=
LIVESYNC_API_KEY=

# --- Amazon Connect (for /api/config and /api/start-chat) ---
AWS_REGION=us-east-1
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
# AWS credentials come from the normal AWS chain (profile / env). Needs connect:StartChatContact.

# --- Server ---
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

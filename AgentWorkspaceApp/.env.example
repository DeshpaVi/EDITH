# ---------------------------------------------------------------------------
# All VITE_* values are baked into the JavaScript bundle and are therefore
# PUBLIC. Never put an AWS access key, a Cognito client secret, or any other
# credential in this file. The Cognito app client used here must be a PUBLIC
# client (no secret) using authorization-code + PKCE.
# ---------------------------------------------------------------------------

# Which contact/attribute source the app binds to.
#   workspace = the real Amazon Connect agent workspace SDK (iframe host)
#   mock      = local fixture data, for development outside the workspace
VITE_BRIDGE=workspace

# Where transcript segments come from.
#   api  = the backend proxy (API Gateway + Lambda -> Contact Lens real-time)
#   mock = a scripted fixture conversation, for development
VITE_TRANSCRIPT_SOURCE=api

# Invoke URL of the HTTP API stage, no trailing slash.
# Output `ApiBaseUrl` of infra/backend.yaml.
VITE_API_BASE_URL=https://abc123.execute-api.ap-south-1.amazonaws.com

# Auth against the backend. `none` is only valid with VITE_TRANSCRIPT_SOURCE=mock.
VITE_AUTH_MODE=cognito

# Cognito Hosted UI domain, no scheme, no trailing slash.
VITE_COGNITO_DOMAIN=acw-handoff.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_PUBLIC_APP_CLIENT_ID
VITE_COGNITO_SCOPES=openid email profile

# Poll cadence for transcript segments, milliseconds.
# Contact Lens emits a segment roughly every 2-5s; below ~2000 you burn
# API quota without gaining words. See docs/LIMITATIONS.md.
VITE_TRANSCRIPT_POLL_MS=3000

# How often contact attributes are re-read from the workspace while a contact
# is live. Flows can set attributes mid-call, so this is not a one-shot read.
VITE_ATTRIBUTE_REFRESH_MS=5000

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private static hosting for JourneyForge: S3 (not public) behind CloudFront, with sign-in through Amazon Cognito (Hosted UI, authorization code with PKCE). A CloudFront Function checks a signed session cookie on every request; a small Lambda handles /auth/*. See hosting/README.md.",
  "Parameters": {
    "AdminEmail": {
      "Type": "String",
      "AllowedPattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+",
      "Description": "First user. Cognito emails this address a temporary password."
    },
    "DomainPrefix": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])?",
      "Description": "Prefix of the Cognito sign-in address (<prefix>.auth.<region>.amazoncognito.com). Must be unique in the region and must not contain \"aws\", \"amazon\" or \"cognito\"."
    },
    "SessionKey": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "[A-Za-z0-9]{32,64}",
      "Description": "Random secret (32 to 64 letters and digits) that signs session cookies. The deploy script generates one."
    },
    "AuthCodeBucket": {
      "Type": "String",
      "AllowedPattern": "[0-9A-Za-z._-]*[0-9A-Za-z_-]",
      "ConstraintDescription": "Only the bucket name: no s3://, no ARN, no slash, no spaces, no trailing dot.",
      "Description": "Bucket NAME only (same region as this stack) holding auth.zip, the zipped contents of hosting/auth-lambda."
    },
    "AuthCodeKey": {
      "Type": "String",
      "Default": "auth.zip",
      "AllowedPattern": "[^\\s]+",
      "ConstraintDescription": "The object key, no spaces (auth.zip).",
      "Description": "S3 key of the zip."
    },
    "SessionHours": {
      "Type": "Number",
      "Default": 8,
      "MinValue": 1,
      "MaxValue": 72,
      "Description": "How long a sign-in lasts."
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      }
    },
    "SiteOac": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-oac"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SessionCheck": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-session"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Requires a valid session cookie",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": {
          "Fn::Join": [
            "",
            [
              "var KEY = '",
              {
                "Ref": "SessionKey"
              },
              "';\n",
              "// CloudFront Function (cloudfront-js-2.0), viewer-request, on every request except /auth/*.\n// KEY (the session signing key) is prepended by the template. Lets a request through only with a valid session cookie:\n//   jf_session = <expiry-seconds>.<cognito-sub>.<hex hmac-sha256 of \"<expiry>.<sub>\">\n// Anything else is sent to /auth/login. The cookie is issued by the auth Lambda after a successful Cognito sign-in.\nvar crypto = require('crypto');\n\nfunction valid(cookie) {\n  var parts = String(cookie || '').split('.');\n  if (parts.length !== 3) return false;\n  var exp = Number(parts[0]);\n  if (!(exp > Math.floor(Date.now() / 1000))) return false;\n  var want = crypto.createHmac('sha256', KEY).update(parts[0] + '.' + parts[1]).digest('hex');\n  return want === parts[2];\n}\n\nfunction handler(event) {\n  var request = event.request;\n  var c = request.cookies && request.cookies.jf_session;\n  if (c && valid(c.value)) return request;\n  return {\n    statusCode: 302,\n    statusDescription: 'Found',\n    headers: { location: { value: '/auth/login' }, 'cache-control': { value: 'no-store' } },\n  };\n}\n"
            ]
          ]
        }
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true,
          "InviteMessageTemplate": {
            "EmailSubject": "Your JourneyForge sign-in",
            "EmailMessage": "Your user name is {username} and your temporary password is {####}. You will be asked to choose a new password the first time you sign in."
          }
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 7
          }
        },
        "MfaConfiguration": "OPTIONAL",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        }
      }
    },
    "UserPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Ref": "DomainPrefix"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        }
      }
    },
    "FirstUser": {
      "Type": "AWS::Cognito::UserPoolUser",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "Username": {
          "Ref": "AdminEmail"
        },
        "DesiredDeliveryMediums": [
          "EMAIL"
        ],
        "UserAttributes": [
          {
            "Name": "email",
            "Value": {
              "Ref": "AdminEmail"
            }
          },
          {
            "Name": "email_verified",
            "Value": "true"
          }
        ]
      }
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": {
          "Fn::Sub": "${AWS::StackName}-site"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "https://${SiteDistribution.DomainName}/auth/callback"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "https://${SiteDistribution.DomainName}/auth/signed-out"
          }
        ],
        "PreventUserExistenceErrors": "ENABLED"
      }
    },
    "AuthConfig": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/${AWS::StackName}/auth"
        },
        "Type": "String",
        "Value": {
          "Fn::Join": [
            "",
            [
              "{\"region\":\"",
              {
                "Ref": "AWS::Region"
              },
              "\",\"userPoolId\":\"",
              {
                "Ref": "UserPool"
              },
              "\",\"clientId\":\"",
              {
                "Ref": "UserPoolClient"
              },
              "\",\"domain\":\"",
              {
                "Ref": "DomainPrefix"
              },
              ".auth.",
              {
                "Ref": "AWS::Region"
              },
              ".amazoncognito.com\",\"siteUrl\":\"",
              {
                "Fn::Sub": "https://${SiteDistribution.DomainName}"
              },
              "\"}"
            ]
          ]
        }
      }
    },
    "AuthRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "ReadAuthConfig",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/${AWS::StackName}/auth"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "AuthFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Timeout": 10,
        "Role": {
          "Fn::GetAtt": [
            "AuthRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "AuthCodeBucket"
          },
          "S3Key": {
            "Ref": "AuthCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "CONFIG_PARAMETER": {
              "Fn::Sub": "/${AWS::StackName}/auth"
            },
            "SESSION_KEY": {
              "Ref": "SessionKey"
            },
            "SESSION_HOURS": {
              "Ref": "SessionHours"
            }
          }
        }
      }
    },
    "AuthUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "AuthFunction",
            "Arn"
          ]
        }
      }
    },
    "AuthUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "AuthFunction"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "AuthInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "AuthFunction"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "${AWS::StackName}"
          },
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "site-bucket",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Fn::GetAtt": [
                  "SiteOac",
                  "Id"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "auth",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": [
                          "AuthUrl",
                          "FunctionUrl"
                        ]
                      }
                    ]
                  }
                ]
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "HTTPSPort": 443
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site-bucket",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SessionCheck",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/auth/*",
              "TargetOriginId": "auth",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": "4135ea2d-6df8-481c-89c2-5ee2dfa8b33c",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03"
            }
          ]
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFrontRead",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "SiteUrl": {
      "Description": "Open this address; you are sent to the sign-in page.",
      "Value": {
        "Fn::Sub": "https://${SiteDistribution.DomainName}"
      }
    },
    "SiteBucketName": {
      "Description": "Upload the built site (dist/) here.",
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Description": "Invalidate this after each upload.",
      "Value": {
        "Ref": "SiteDistribution"
      }
    },
    "UserPoolId": {
      "Description": "Add more users here (console, or aws cognito-idp admin-create-user).",
      "Value": {
        "Ref": "UserPool"
      }
    }
  }
}

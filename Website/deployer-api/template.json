{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Deployer API: previews and deploys the CloudFormation templates generated by the journey tool into target accounts, through customer-created roles.",
  "Parameters": {
    "AllowedOrigin": {
      "Type": "String",
      "Description": "Origin of the website that calls the deployer, for example https://app.example.com or http://localhost:5173.",
      "AllowedPattern": "https?://.+"
    },
    "AccessToken": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 24,
      "Description": "Bearer token consultants enter in the tool. Stored in Secrets Manager."
    },
    "TargetsJson": {
      "Type": "String",
      "Description": "JSON array of deploy targets: [{\"id\":\"acme\",\"label\":\"ACME sandbox\",\"roleArn\":\"arn:aws:iam::<acct>:role/edith/EdithDeployRole\",\"externalId\":\"<id>\",\"region\":\"us-east-1\",\"stackRoleArn\":\"arn:aws:iam::<acct>:role/edith/EdithStackRole\"}]"
    },
    "TargetRoleArns": {
      "Type": "CommaDelimitedList",
      "Description": "The same deploy role ARNs as in TargetsJson. The deployer may assume only these."
    },
    "ArtifactBucket": {
      "Type": "String",
      "Description": "Bucket holding the published provisioner package.",
      "AllowedPattern": "[0-9A-Za-z._-]*[0-9A-Za-z_-]",
      "ConstraintDescription": "Only the bucket name: no s3://, no ARN, no slash, no spaces."
    },
    "ArtifactKey": {
      "Type": "String",
      "Description": "Key of the published provisioner package.",
      "AllowedPattern": ".+"
    },
    "DeployerCodeBucket": {
      "Type": "String",
      "AllowedPattern": "[0-9A-Za-z._-]*[0-9A-Za-z_-]",
      "ConstraintDescription": "Only the bucket name: no s3://, no ARN, no slash, no spaces.",
      "Description": "Bucket NAME only, in this stack's region, holding deployer.zip."
    },
    "DeployerCodeKey": {
      "Type": "String",
      "Default": "deployer.zip",
      "AllowedPattern": "[^\\s]+",
      "Description": "S3 key of the zip (index.mjs, cfn.mjs, confirm.mjs, policy.mjs and package.json at its root)."
    }
  },
  "Resources": {
    "TokenSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Bearer token for the deployer API.",
        "SecretString": {
          "Ref": "AccessToken"
        }
      }
    },
    "ConfirmSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Signing key for change-set confirmation tokens.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "DeployerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "AssumeTargetRoles",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sts:AssumeRole",
                  "Resource": {
                    "Ref": "TargetRoleArns"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "StoreLargeTemplates",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/templates/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DeployerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Timeout": 180,
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "DeployerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "DeployerCodeBucket"
          },
          "S3Key": {
            "Ref": "DeployerCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "ACCESS_TOKEN": {
              "Fn::Sub": "{{resolve:secretsmanager:${TokenSecret}:SecretString}}"
            },
            "CONFIRM_KEY": {
              "Fn::Sub": "{{resolve:secretsmanager:${ConfirmSecret}:SecretString}}"
            },
            "TARGETS": {
              "Ref": "TargetsJson"
            },
            "ARTIFACT_BUCKET": {
              "Ref": "ArtifactBucket"
            },
            "ARTIFACT_KEY": {
              "Ref": "ArtifactKey"
            },
            "ARTIFACT_REGION": {
              "Ref": "AWS::Region"
            }
          }
        }
      }
    },
    "DeployerUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "DeployerFunction",
            "Arn"
          ]
        },
        "Cors": {
          "AllowOrigins": [
            {
              "Ref": "AllowedOrigin"
            }
          ],
          "AllowMethods": [
            "GET",
            "POST"
          ],
          "AllowHeaders": [
            "content-type",
            "authorization"
          ],
          "MaxAge": 3600
        }
      }
    },
    "DeployerUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "DeployerFunction"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "DeployerInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "DeployerFunction"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "DeployerUrl": {
      "Description": "Paste this URL into the tool's Deploy step.",
      "Value": {
        "Fn::GetAtt": [
          "DeployerUrl",
          "FunctionUrl"
        ]
      }
    },
    "DeployerRoleArn": {
      "Description": "Give this to each customer: it is the principal their deploy role trusts.",
      "Value": {
        "Fn::GetAtt": [
          "DeployerRole",
          "Arn"
        ]
      }
    }
  }
}

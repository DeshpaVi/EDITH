{
  "metadata": { "schemaVersion": "1.0", "importType": "LEX", "importFormat": "JSON" },
  "resource": {
    "name": "AcmeLegacyBot",
    "locale": "en-US",
    "intents": [
      {
        "name": "PayBill",
        "sampleUtterances": ["pay my bill", "make a payment"],
        "slots": [
          {
            "name": "accountNumber",
            "slotType": "AMAZON.NUMBER",
            "slotConstraint": "Required",
            "obfuscationSetting": "DEFAULT_OBFUSCATION",
            "valueElicitationPrompt": { "maxAttempts": 2, "messages": [{ "contentType": "PlainText", "content": "What is your account number?" }] }
          }
        ],
        "confirmationPrompt": { "messages": [{ "contentType": "PlainText", "content": "Shall I go ahead?" }] },
        "conclusionStatement": { "messages": [{ "contentType": "PlainText", "content": "All done." }] },
        "fulfillmentActivity": { "type": "CodeHook", "codeHook": { "uri": "arn:aws:lambda:us-east-1:111122223333:function:LegacyPay", "messageVersion": "1.0" } }
      }
    ],
    "slotTypes": [
      { "name": "BillingTopic", "enumerationValues": [{ "value": "billing", "synonyms": ["bill", "invoice"] }] }
    ]
  }
}
